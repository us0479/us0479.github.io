# BankWatch Docker Compose 전용 설정 예제 (UTF-8).
# Windows cmd: if not exist .env copy .env.example .env
# 기존 .env가 있으면 비밀번호를 보존하고 빠진 항목만 추가한다.
# 아래 비밀번호 다섯 개를 서로 다른 로컬 값으로 채운다. 실제 .env는 커밋하지 않는다.
# 값에 $, # 또는 공백이 있으면 작은따옴표로 감싸 문자 그대로 전달한다.
# 직접 Java/Maven으로 실행할 때는 이 파일이 자동으로 로드되지 않는다.

# DB 초기화와 일회성 bootstrap 서비스에서 사용하는 소유자 비밀번호.
OWNER_DB_PASSWORD=

# 일반 웹 앱이 사용하는 bankwatch_app DB 역할의 비밀번호.
APP_DB_PASSWORD=

# 최초 생성할 운영자 3명의 비밀번호. 각 값은 UTF-8 기준 72바이트 이하여야 한다.
# 기존 DB 비밀번호와 운영자 비밀번호는 이 파일 수정만으로 변경되지 않는다.
BANKWATCH_ADMIN_PASSWORD=
BANKWATCH_ANALYST_A_PASSWORD=
BANKWATCH_ANALYST_B_PASSWORD=

# 선택: 호스트의 웹 포트. 비우면 8080이며 127.0.0.1에만 공개한다.
BANKWATCH_PORT=8080
